# Everything here is OPTIONAL. With no .env at all, `docker compose up` generates its own
# secrets on first start and keeps them in the `state` volume.
#
# Copy to infra/compose/.env (git-ignored) only to override. A secret you set here must match
# the one the install was created with; the container refuses to start otherwise, because a
# different ENCRYPTION_KEY makes stored messages and linked numbers unreadable.
#
# Back up the state volume's secrets.env somewhere OTHER than the database backup.
# APP_SECRET=
# API_KEY=
# ENCRYPTION_KEY=
# ENCRYPTION_INDEX_KEY=

# First-run admin (used once, when the install is empty).
# ADMIN_EMAIL=admin@example.com
# ORG_NAME=My Organisation
# ORG_SLUG=my-org

# Where people reach it, and the install's local timezone (NOT the server's).
# PUBLIC_URL=http://localhost:3001
# SEND_TIMEZONE=Asia/Kolkata

# Host ports, if the defaults are taken.
# API_HOST_PORT=3000
# WEB_HOST_PORT=3001
# POSTGRES_HOST_PORT=5434
# POSTGRES_PASSWORD=crm

# Cloudflare Tunnel (npm run alpha:tunnel; see docs/30-cloudflare-tunnel.md).
# TUNNEL_TOKEN=
# TUNNEL_PROTOCOL=auto        # or http2 if the network drops UDP

# File storage. Default is the local volume. For a bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO), set
# STORAGE_DRIVER=s3 (or minio) and all of the S3_* values; the app refuses to start if one is missing.
# Existing local files are not copied; see docs/21-deferred.md D-63.
# STORAGE_DRIVER=filesystem
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=

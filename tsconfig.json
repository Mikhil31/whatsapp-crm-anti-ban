{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@crm/shared": ["packages/shared/src/index.ts"],
      "@crm/db": ["packages/db/src/index.ts"],
      "@crm/channels": ["packages/channels/src/index.ts"],
      "@crm/channel-fake": ["packages/channels/fake/src/index.ts"],
      "@crm/kms-local": ["packages/providers/kms/local/src/index.ts"],
      "@crm/auth-builtin": ["packages/providers/auth/builtin/src/index.ts"],
      "@crm/llm": ["packages/providers/llm/src/index.ts"],
      "@crm/storage": ["packages/providers/storage/src/index.ts"],
      "@crm/storage-filesystem": ["packages/providers/storage/filesystem/src/index.ts"],
      "@crm/storage-s3": ["packages/providers/storage/s3/src/index.ts"],
      "@crm/channel-baileys": ["packages/channels/baileys/src/index.ts"],
      "@crm/core": ["packages/core/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "*.ts"],
  "exclude": [
    "node_modules",
    // Vendored Baileys (packages/baileys) builds with its own tsconfig: npm run baileys:build.
    "packages/baileys",
    "**/dist",
    // apps/web is a Next.js app: it needs the DOM lib, JSX and React types, none of
    // which belong in the Node-only server config. It typechecks against its own
    // tsconfig via `npm run typecheck:web`, which `npm run check` also runs.
    "apps/web"
  ]
}

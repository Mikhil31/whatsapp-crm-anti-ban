# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
# vendored Baileys build output (npm run baileys:build)
packages/baileys/lib/
.next/
*.tsbuildinfo
# Regenerated by Next on every dev/build, and it references files inside .next/,
# so committing it would break a fresh clone's typecheck.
apps/web/next-env.d.ts

# environment & secrets — never commit these
.env
.env.*
!.env.example
# The two rules above only cover `.env` and `.env.<something>`. They do NOT match a name
# like `.og_env` or `prod.env`, which is exactly what a hand-made backup gets called — and
# one `git add -A` would publish ENCRYPTION_KEY, the one secret with no recovery.
# These two cover both shapes and match no source file: `env.ts`, `environment.ts` and
# `docs/env.md` all stay tracked.
.*env
*.env
config/preset.local.yml
*.pem
*.key

# runtime state
uploads/
/storage/
logs/
*.log

# local data volumes
data/
pgdata/

# test & coverage
coverage/
.vitest/
playwright-report/
test-results/

# editor / OS
.DS_Store
.idea/
*.swp

# Logs from `npm run dev:all`. Per-run, never useful to anyone else.
.dev-logs/

# Insomnia workspace auto-exports. The curated collection is tools/insomnia-collection.json.
*(local)-wrk_*.yaml
Insomnia_*.yaml
/whatsapp-crm-docs.pdf

# Generated by `npm run db:docs`; regenerate rather than commit.
docs/generated/

# per-run resource footprint written by scripts/verify.sh
verify-footprint.log

# throwaway design mockups (static HTML for choosing a look; never part of the app)
mockups/

# Real end-user data files kept for local testing only (personal data; never commit)
/private/

# Dated backups the AI settings tab makes of the env file before changing it (they hold keys)
.env.bak-*
*.env.bak-*
dedup-report-*.csv
regression-report.md

# Tester feedback batches: screenshots and notes show real names and phone numbers, and this repository is public.
dev-feedback-*/
dev-feedback-*.md
docs/feedback/inbox/
